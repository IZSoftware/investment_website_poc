# Baked into the bundle by `npm run build` (CRA reads this file for production
# builds). The Docker image build passes the same values as build args, and a
# real environment variable always wins over this file.
REACT_APP_API_BASE_URL=https://investors-portal-backend-885787520862.europe-west1.run.app

# The CRA ESLint plugin fails the production build on warnings when CI=true,
# which is how Cloud Build/Vercel run it.
DISABLE_ESLINT_PLUGIN=true

# Dev-server-only flag; kept here so every build path uses one config.
FAST_REFRESH=false
